# Secrets only. Everything else lives in config/config.json.

TELEGRAM_BOT_TOKEN=          # from @BotFather
TELEGRAM_ALLOWED_CHAT_ID=    # send /start to the bot to see yours
JSEARCH_API_KEY=             # OpenWebNinja dashboard → JSearch API key

# Database: local file by default. On Vercel use Turso: libsql://<db>.turso.io
TURSO_DATABASE_URL=file:jobs.db
TURSO_AUTH_TOKEN=

# Vercel only
TELEGRAM_WEBHOOK_SECRET=     # any random string; also passed to setWebhook
CRON_SECRET=                 # any random string; Vercel Cron sends it automatically
XAI_API_KEY=                 # Grok API (console.x.ai). Vercel can't run Codex, so it uses Grok
